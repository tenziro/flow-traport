# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# 편집기 임시 파일. v0.9.x 때 Vim 스왑 파일 2개가 커밋에 섞여 들어갔다.
*.swp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.playwright-mcp
# 계획 실행용 작업 폴더 (원장·브리프·리뷰 패키지). 기록은 git 커밋에 남는다.
/.superpowers
